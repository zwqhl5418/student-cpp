FROM debian:bookworm-slim

# 安装编译 + 测试依赖
RUN apt-get update && apt-get install -y --no-install-recommends \
    g++ make libpq-dev libgtest-dev lcov curl \
    && rm -rf /var/lib/apt/lists/*

# 编译 Google Test 库（Debian 的 libgtest-dev 只提供源码）
RUN cd /usr/src/gtest && g++ -std=c++11 -Iinclude -pthread -c src/gtest-all.cc -o gtest-all.o \
    && ar rcs /usr/lib/libgtest.a gtest-all.o \
    && g++ -std=c++11 -Iinclude -pthread -c src/gtest_main.cc -o gtest_main.o \
    && ar rcs /usr/lib/libgtest_main.a gtest_main.o

WORKDIR /app
COPY . .

# 移除 vendored libpq 符号链接，使用系统安装的
RUN rm -f lib/libpq.so

# 编译并运行测试
CMD ["bash", "-c", "echo 'waiting for db...'; while ! timeout 1 bash -c 'echo >/dev/tcp/$DB_HOST/$DB_PORT' 2>/dev/null; do sleep 1; done; echo 'db ready, running tests'; make CXXFLAGS='-std=c++11 -Wall -Wextra -g -O0 -Iinclude' LDFLAGS='-lpq -lpthread -lgtest -lgtest_main' test"]
