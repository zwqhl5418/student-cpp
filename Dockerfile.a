FROM docker.m.daocloud.io/library/debian:bookworm-slim

# 安装编译工具链和 PostgreSQL 客户端
RUN apt-get update && apt-get install -y --no-install-recommends \
    g++ make libpq-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY . .

# 编译 A 方案（httplib.h v0.23 需要 C++14）
RUN make SCHEME=A CXXFLAGS="-std=c++14 -Wall -Wextra -O2 -Iinclude" \
    LDFLAGS="-lpq -lpthread -Llib -Wl,-rpath,lib" -j$(nproc)

EXPOSE 8080

CMD ["bash", "-c", "while ! timeout 1 bash -c 'echo >/dev/tcp/$DB_HOST/$DB_PORT' 2>/dev/null; do echo 'waiting for db...'; sleep 1; done; echo 'db ready'; exec ./build/app_a"]
